{
    "name": "hgabka/acl-bundle",
    "type": "symfony-bundle",
    "description": "Symfony AclBundle fork",
    "keywords": [],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/logger-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/node-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/media-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/settings-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/utils-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/seo-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/doctrine-translatable.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/doctrine-translatable-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/email-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/simple-content-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/i18n-routing-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/security-acl.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/pagepart-bundle.git"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-xml": "*",
        "symfony/dependency-injection": "^7.0|^8.1",
        "symfony/http-kernel": "^7.0|^8.1",
        "symfony/security-acl": "^7.1|^8.0.0",
        "symfony/security-bundle": "^7.0|^8.1"
    },
    "require-dev": {
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.11|^3.0",
        "doctrine/orm": "^3.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0",
        "symfony/console": "^7.0|^8.0",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/phpunit-bridge": "^7.0|^8.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "To use the default dbal configuration"
    },
    "replace": {
        "symfony/acl-bundle": "*"
    },
    "autoload": {
        "psr-4": {
            "Symfony\\Bundle\\AclBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\Bundle\\AclBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "conflict": {
        "doctrine/dbal": "<2.13.1|~3.0.0"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev",
            "dev-v8": "8.0.x-dev"
        }
    }
}
